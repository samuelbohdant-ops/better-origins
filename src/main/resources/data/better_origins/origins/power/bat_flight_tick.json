{
  "type": "origins:action_over_time",
  "interval": 1,
  "hidden": true,
  "entity_action": {
    "type": "origins:if_else_list",
    "actions": [
      {
        "condition": {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:creative_flying"
            },
            {
              "type": "origins:resource",
              "resource": "better_origins:bat_flight_time",
              "comparison": ">",
              "compare_to": 0
            }
          ]
        },
        "action": {
          "type": "origins:change_resource",
          "resource": "better_origins:bat_flight_time",
          "change": -1
        }
      },
      {
        "condition": {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:not",
              "condition": {
                "type": "origins:creative_flying"
              }
            },
            {
              "type": "origins:resource",
              "resource": "better_origins:bat_flight_time",
              "comparison": "<",
              "compare_to": 600
            }
          ]
        },
        "action": {
          "type": "origins:change_resource",
          "resource": "better_origins:bat_flight_time",
          "change": 1
        }
      }
    ]
  }
}