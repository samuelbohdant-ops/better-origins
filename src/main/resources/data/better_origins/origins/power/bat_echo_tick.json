{
  "type": "origins:action_over_time",
  "interval": 1,
  "hidden": true,
  "entity_action": {
    "type": "origins:if_else_list",
    "actions": [
      {
        "condition": {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:power_active",
              "power": "better_origins:bat_echo"
            },
            {
              "type": "origins:resource",
              "resource": "better_origins:bat_echo_time",
              "comparison": ">",
              "compare_to": 0
            }
          ]
        },
        "action": {
          "type": "origins:change_resource",
          "resource": "better_origins:bat_echo_time",
          "change": -1
        }
      },
      {
        "condition": {
          "type": "origins:power_active",
          "power": "better_origins:bat_echo"
        },
        "action": {
          "type": "origins:toggle",
          "power": "better_origins:bat_echo"
        }
      },
      {
        "condition": {
          "type": "origins:resource",
          "resource": "better_origins:bat_echo_time",
          "comparison": "<",
          "compare_to": 300
        },
        "action": {
          "type": "origins:change_resource",
          "resource": "better_origins:bat_echo_time",
          "change": 1
        }
      }
    ]
  }
}