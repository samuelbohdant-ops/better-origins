{
  "type": "origins:action_over_time",
  "interval": 1,
  "hidden": true,
  "entity_action": {
    "type": "origins:if_else_list",
    "actions": [
      {
        "condition": {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:power_active",
              "power": "better_origins:cw_parasites"
            },
            {
              "type": "origins:resource",
              "resource": "better_origins:cw_parasites_cooldown",
              "comparison": ">",
              "compare_to": 0
            }
          ]
        },
        "action": {
          "type": "origins:toggle",
          "power": "better_origins:cw_parasites"
        }
      },
      {
        "condition": {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:power_active",
              "power": "better_origins:cw_parasites"
            },
            {
              "type": "origins:resource",
              "resource": "better_origins:cw_parasites_time",
              "comparison": ">",
              "compare_to": 0
            }
          ]
        },
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:change_resource",
              "resource": "better_origins:cw_parasites_time",
              "change": -1
            },
            {
              "type": "origins:change_resource",
              "resource": "better_origins:cw_parasites_was_on",
              "change": 1,
              "operation": "set"
            }
          ]
        }
      },
      {
        "condition": {
          "type": "origins:power_active",
          "power": "better_origins:cw_parasites"
        },
        "action": {
          "type": "origins:toggle",
          "power": "better_origins:cw_parasites"
        }
      },
      {
        "condition": {
          "type": "origins:resource",
          "resource": "better_origins:cw_parasites_was_on",
          "comparison": ">",
          "compare_to": 0
        },
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:change_resource",
              "resource": "better_origins:cw_parasites_cooldown",
              "change": 100,
              "operation": "set"
            },
            {
              "type": "origins:change_resource",
              "resource": "better_origins:cw_parasites_was_on",
              "change": 0,
              "operation": "set"
            }
          ]
        }
      },
      {
        "condition": {
          "type": "origins:constant",
          "value": true
        },
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:if_else",
              "condition": {
                "type": "origins:resource",
                "resource": "better_origins:cw_parasites_time",
                "comparison": "<",
                "compare_to": 300
              },
              "if_action": {
                "type": "origins:change_resource",
                "resource": "better_origins:cw_parasites_time",
                "change": 1
              }
            },
            {
              "type": "origins:if_else",
              "condition": {
                "type": "origins:resource",
                "resource": "better_origins:cw_parasites_cooldown",
                "comparison": ">",
                "compare_to": 0
              },
              "if_action": {
                "type": "origins:change_resource",
                "resource": "better_origins:cw_parasites_cooldown",
                "change": -1
              }
            }
          ]
        }
      }
    ]
  }
}